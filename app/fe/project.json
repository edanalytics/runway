{
  "name": "fe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "fe/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project fe --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx tsc --noEmit --project ./fe/tsconfig.app.json",
          "npx tsc --noEmit --project ./fe/tsconfig.spec.json"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config ./fe/vite.config.mts"
      }
    }
  }
}
